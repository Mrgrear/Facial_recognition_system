# Python environments
venv/
.venv/
.env
.env.*

# Python cache / compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Logs
*.log

# Local/editor files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test/coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Local generated runtime state
*.tmp
*.bak

# Biometric and runtime data
# Keep real user data, embeddings, audit logs and local databases out of Git.
db/*.json
db/*.pkl
db/*.pickle
models/*.pkl
models/*.pickle
models/*.joblib
models/*.onnx
models/*.bin

# Local datasets and captured images
# Commit only synthetic/sample data that is explicitly safe to publish.
dataset/raw/
dataset/captured/
dataset/private/
*.jpg
*.jpeg
*.png
*.bmp
*.webp
